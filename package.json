    "prisma:migrate": "prisma migrate dev",
    "prisma:seed-catalogue": "tsx prisma/seed-catalogue.ts",
    "test": "tsx --test tests/security-primitives.test.ts",
    "test:e2e": "playwright test",
    "test:integration": "tsx --test tests/*.integration.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.4.2",
    "@prisma/client": "^5.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-auth": "^4.24.11",
    "prisma": "^5.7.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.15.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.24.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.1",
    "typescript": "^5.7.2",
    "@types/bcryptjs": "^2.4.6",
    "@playwright/test": "1.55.0"
  }
